# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / OS
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store

# Builds
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# Gradle / Android
.gradle/
ExportedObj/

# Android native build intermediates (Gradle/CMake)
/.utmp/

# Local Meta debugger settings (machine specific, holds a local access token)
/Assets/Resources/DevAgentSettings.asset
/Assets/Resources/DevAgentSettings.asset.meta

# Temporary files that Unity packages write during a player build (deleted when the build ends)
/Assets/Resources/PerformanceTestRunInfo.json*
/Assets/Resources/PerformanceTestRunSettings.json*
/Assets/StreamingAssets/RuntimeActionBindings.json*
